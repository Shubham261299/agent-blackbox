# The API. Installs only what running the app needs (no test, GIF or judge tooling): see pyproject.toml.
FROM python:3.12-slim

# An editable install keeps the code where the project expects it (datasets, paths relative to the repository).
WORKDIR /app
COPY pyproject.toml ./
COPY backend ./backend
RUN pip install --no-cache-dir -e . \
    && useradd --create-home --uid 10001 blackbox \
    && mkdir /data && chown blackbox /data

USER blackbox
ENV BLACKBOX_DB_PATH=/data/blackbox.db
VOLUME /data
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"

CMD ["uvicorn", "--factory", "blackbox.api.main:create_app", "--host", "0.0.0.0", "--port", "8000"]
